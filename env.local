# Location of your custom PostgreSQL install and data dir
export PG_PREFIX="$HOME/pg-auth"
export PGDATA="$HOME/pg-auth-data"

# Port your build.sh script used
export PGPORT=55432

# Put custom postgres binaries first in PATH
export PATH="$PG_PREFIX/bin:$PATH"

# Optional: Cedar URL if you want it handy in your shell too
export CEDAR_URL="http://localhost:8280"